# Chuỗi kết nối MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/magic_door
PORT=3000

# Khóa bí mật để ký token đăng nhập (chuỗi ngẫu nhiên, ít nhất 16 ký tự)
